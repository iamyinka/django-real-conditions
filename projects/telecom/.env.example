# Copy to .env for local development:   cp .env.example .env
# .env is git-ignored. These are throwaway development values: never reuse them anywhere real.

# Django
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. The postgres image reads POSTGRES_* only the FIRST time it initializes
# an empty data directory. Changing them later doesn't change an existing database.
POSTGRES_DB=telecom
POSTGRES_USER=telecom
POSTGRES_PASSWORD=dev-only-change-me

# How Django reaches the database: the Compose service name, not localhost.
DB_HOST=db
DB_PORT=5432
